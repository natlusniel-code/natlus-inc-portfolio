{
  "name": "natlus-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Natlus Inc. — Software Developer Portfolio Website with a public portfolio site and a /natlus admin panel.",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs dev-server.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node db/migrate.mjs",
    "db:seed": "node db/seed.mjs",
    "verify:whatsapp": "node scripts/verify-whatsapp.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
