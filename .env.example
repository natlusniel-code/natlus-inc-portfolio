# ============================================================
# Natlus Inc. Portfolio — Environment Variables
# Copy this file to .env for local development and set the same
# variables in Vercel (Settings -> Environment Variables) for
# Production and Preview.
# ============================================================

# --- Database (required) -------------------------------------
# Postgres connection string. Use a pooled connection string for
# serverless (Neon: add ?sslmode=require&pgbouncer=true or use the
# pooled URL from the dashboard; Supabase: use the pooled URL).
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# --- Contact form (optional) ---------------------------------
# The contact form always saves messages to the database (visible
# in the /natlus admin panel under "Messages"). If you also want
# each message forwarded by email, set these and the form will
# send through SMTP. Leave empty to keep DB-only delivery.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Natlus Inc. <no-reply@yourdomain.com>
# CONTACT_TO=Natlusniel@gmail.com

# --- Site URL (optional) -------------------------------------
# Used for canonical links and sitemap. Leave empty in dev.
# SITE_URL=https://yourdomain.com
